{
  "mcpServers": {
    "palette": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/palette-mcp-launch.sh",
        "--allow-write=${user_config.allow_write}",
        "--allow-direct-ssh=${user_config.allow_direct_ssh}"
      ],
      "env": {
        "PALETTE_HOST": "${user_config.host}",
        "PALETTE_API_KEY": "${user_config.api_key}",
        "PALETTE_AUTH_TOKEN": "${user_config.auth_token}",
        "PALETTE_CA_FILE": "${user_config.ca_file}",
        "PALETTE_PROFILES_FILE": "${PALETTE_PROFILES_FILE:-}"
      }
    }
  }
}
